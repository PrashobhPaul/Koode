<!--
  The splash window's mark.

  Deliberately a thin alias of ic_koode_mark rather than its own drawing: the
  splash used to carry an older, different logo, so the first thing the app
  showed disagreed with the icon that had just been tapped.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_koode_mark"
    android:inset="0dp" />
