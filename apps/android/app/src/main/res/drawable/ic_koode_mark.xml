<?xml version="1.0" encoding="utf-8"?>
<!--
  The Koode mark, in full dimensional form: two figures — teal and blue —
  modelled as lit, glossy forms whose bodies curve into a heart around a raised
  location pin, on a lit navy plate.

  This is the ONE definition of the mark. The splash, the PDF header and the PDF
  watermark all render this file, so the icon on a home screen, the document a
  family was sent and the app's own splash are the same object by construction.

  It is built to read as 3D while staying a crisp, weightless vector:
   - the heads are shaded spheres (radial light from the upper-left) with a
     specular highlight and a contact shadow,
   - the heart tubes carry a sheen ridge and a top-lit gradient,
   - the pin is glossy and raised, casting a soft shadow into the heart, with a
     recessed hole,
   - the plate has a glow behind the mark and a vignette at its edges.
  No blur filters are used (neither AAPT nor the launcher supports them); every
  soft edge is a gradient, so it renders identically on every device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- plate -->
    <path android:pathData="M24,2 L84,2 A22,22 0 0 1 106,24 L106,84 A22,22 0 0 1 84,106 L24,106 A22,22 0 0 1 2,84 L2,24 A22,22 0 0 1 24,2 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="10" android:startY="0" android:endX="98" android:endY="108">
                <item android:offset="0" android:color="#FF123A57"/>
                <item android:offset="0.5" android:color="#FF0B2033"/>
                <item android:offset="1" android:color="#FF05101B"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- glow behind the mark -->
    <path android:pathData="M24,2 L84,2 A22,22 0 0 1 106,24 L106,84 A22,22 0 0 1 84,106 L24,106 A22,22 0 0 1 2,84 L2,24 A22,22 0 0 1 24,2 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="40" android:gradientRadius="52">
                <item android:offset="0" android:color="#592E7E86"/>
                <item android:offset="1" android:color="#002E7E86"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- top sheen on the plate -->
    <path android:pathData="M24,2 L84,2 A22,22 0 0 1 106,24 L106,40 L2,40 L2,24 A22,22 0 0 1 24,2 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="2" android:endX="54" android:endY="40">
                <item android:offset="0" android:color="#1AFFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft ground shadow of the whole mark -->
    <path android:pathData="M27,86 a27,7 0 1,0 54,0 a27,7 0 1,0 -54,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="86" android:gradientRadius="28">
                <item android:offset="0" android:color="#5C000000"/>
                <item android:offset="1" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- teal arm / left heart lobe -->
    <path android:strokeWidth="10.5" android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000"
        android:pathData="M54,80 C38,69 28,57 29,45 C30,36 38,32 45,35.5 C50,38 53,42 54,46">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="30" android:startY="24" android:endX="52" android:endY="82">
                <item android:offset="0" android:color="#FF57F5DA"/>
                <item android:offset="0.5" android:color="#FF22C6B2"/>
                <item android:offset="1" android:color="#FF0C8D82"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- blue arm / right heart lobe -->
    <path android:strokeWidth="10.5" android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000"
        android:pathData="M54,80 C70,69 80,57 79,45 C78,36 70,32 63,35.5 C58,38 55,42 54,46">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="78" android:startY="24" android:endX="56" android:endY="82">
                <item android:offset="0" android:color="#FF77C0FF"/>
                <item android:offset="0.5" android:color="#FF3D82F2"/>
                <item android:offset="1" android:color="#FF1B54D6"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- sheen ridges along the tubes -->
    <path android:fillColor="#00000000" android:strokeColor="#47FFFFFF" android:strokeWidth="2.4" android:strokeLineCap="round"
        android:pathData="M52,74 C39,64 30.5,54 31.5,45.5 C32.2,39 37,36 42.5,37.8"/>
    <path android:fillColor="#00000000" android:strokeColor="#47FFFFFF" android:strokeWidth="2.4" android:strokeLineCap="round"
        android:pathData="M56,74 C69,64 77.5,54 76.5,45.5 C75.8,39 71,36 65.5,37.8"/>

    <!-- head contact shadows -->
    <path android:fillColor="#5903202B" android:pathData="M34,35 a7,2.4 0 1,0 14,0 a7,2.4 0 1,0 -14,0"/>
    <path android:fillColor="#5903202B" android:pathData="M60,35 a7,2.4 0 1,0 14,0 a7,2.4 0 1,0 -14,0"/>
    <!-- heads as shaded spheres -->
    <path android:pathData="M41,26 m-8.7,0 a8.7,8.7 0 1,1 17.4,0 a8.7,8.7 0 1,1 -17.4,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="37.5" android:centerY="21.5" android:gradientRadius="13">
                <item android:offset="0" android:color="#FF8FFAE6"/>
                <item android:offset="0.45" android:color="#FF37D9C3"/>
                <item android:offset="1" android:color="#FF0C8F84"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M67,26 m-8.7,0 a8.7,8.7 0 1,1 17.4,0 a8.7,8.7 0 1,1 -17.4,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="63.5" android:centerY="21.5" android:gradientRadius="13">
                <item android:offset="0" android:color="#FFAEDBFF"/>
                <item android:offset="0.45" android:color="#FF5AA7FF"/>
                <item android:offset="1" android:color="#FF1E5AE0"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- speculars -->
    <path android:fillColor="#A6FFFFFF" android:pathData="M34.7,22.3 a3.1,2.3 0 1,0 6.2,0 a3.1,2.3 0 1,0 -6.2,0"/>
    <path android:fillColor="#B3FFFFFF" android:pathData="M60.7,22.3 a3.1,2.3 0 1,0 6.2,0 a3.1,2.3 0 1,0 -6.2,0"/>

    <!-- pin: cast shadow, body, gloss, recessed hole -->
    <path android:pathData="M43,76 a11,4.5 0 1,0 22,0 a11,4.5 0 1,0 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="75" android:gradientRadius="12">
                <item android:offset="0" android:color="#8C03202B"/>
                <item android:offset="1" android:color="#0003202B"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,45 c-8,0 -14,6.2 -14,14 C40,68.5 54,79 54,79 c0,0 14,-10.5 14,-20 C68,51.2 62,45 54,45 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="44" android:endX="54" android:endY="80">
                <item android:offset="0" android:color="#FFFFFFFF"/>
                <item android:offset="0.6" android:color="#FFEAF4F8"/>
                <item android:offset="1" android:color="#FFC4D8E1"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,45 c-8,0 -14,6.2 -14,14 C40,68.5 54,79 54,79 c0,0 14,-10.5 14,-20 C68,51.2 62,45 54,45 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="50" android:centerY="52" android:gradientRadius="12">
                <item android:offset="0" android:color="#E6FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,58.5 m-5.4,0 a5.4,5.4 0 1,1 10.8,0 a5.4,5.4 0 1,1 -10.8,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="57" android:gradientRadius="6.4">
                <item android:offset="0.6" android:color="#FF06121C"/>
                <item android:offset="1" android:color="#FF12303F"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#FF081019" android:pathData="M54,58.5 m-5.1,0 a5.1,5.1 0 1,1 10.2,0 a5.1,5.1 0 1,1 -10.2,0"/>

    <!-- vignette -->
    <path android:pathData="M24,2 L84,2 A22,22 0 0 1 106,24 L106,84 A22,22 0 0 1 84,106 L24,106 A22,22 0 0 1 2,84 L2,24 A22,22 0 0 1 24,2 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="58" android:gradientRadius="66">
                <item android:offset="0.55" android:color="#00000000"/>
                <item android:offset="1" android:color="#6B000000"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
