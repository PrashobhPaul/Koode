<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking / connectivity awareness -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location: tracking runs ONLY during an explicitly started trip via a
         foreground service (prominent persistent notification). Background
         location is optional and only used to survive reboot / long screen-off
         periods during an active trip. See docs/spec/10_SECURITY_PRIVACY_PLAYSTORE.md -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground services (Android 14+ typed): driver tracking (location)
         and viewer trip-following alerts (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Activity recognition improves stop/restart detection (optional signal) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Restore active-trip tracking after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional FASTag/toll-SMS detection. Strictly opt-in (a setting the
         traveller turns on, then grants at runtime). Toll SMS are parsed
         on-device to recognise a toll crossing; the message body is never
         stored or uploaded. Nothing here reads OTPs or unrelated SMS. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
      Package visibility (Android 11+). Koode asks only whether WhatsApp is
      installed, so it can offer to send a finished journey's timeline to the
      traveller's circle. Nothing is read from it and nothing is sent without
      the traveller tapping send inside WhatsApp itself.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".TripPulseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Koode">

        <!-- The launcher activity wears the splash theme; the platform hands
             over to Theme.Koode (postSplashScreenTheme) once the first frame
             is ready, so a cold start never shows an empty window. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Koode.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google Maps → Share → Koode: a place picked in Maps fills in a journey stop. -->
            <intent-filter android:label="Add to Koode journey">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- A "follow this journey" link opens Koode straight on the Follow
                 screen with the number/passcode filled in. autoVerify makes the
                 tap open the app once assetlinks.json is served from the site
                 root (see docs/MAPS_SETUP.md); until then the link opens the
                 browser viewer, which needs nothing installed. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="prashobhpaul.github.io"
                    android:pathPrefix="/Koode/" />
            </intent-filter>
        </activity>

        <!-- Active-trip tracking. Started only from an explicit user action
             while the app is visible; stopped when the trip ends. -->
        <service
            android:name=".service.TripTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Viewer-side alert engine: polls followed trips and raises forced
             notifications (trip started / SOS / arrival). No push service. -->
        <service
            android:name=".service.TripFollowService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- The last few seconds before the phone goes off. Exported because
             ACTION_SHUTDOWN is a protected system broadcast: only the system
             can send it, so nothing else can trigger this. -->
        <receiver
            android:name=".service.ShutdownReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <!-- FASTag/toll SMS detection. Exported with the BROADCAST_SMS
             permission because SMS_RECEIVED is a protected system broadcast
             only the OS can send. Inert unless the traveller enabled toll
             detection AND granted RECEIVE_SMS; parsing is on-device only. -->
        <receiver
            android:name=".service.TollSmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Shares exported journey PDFs (and nothing else) with the app the
             user picks. Grants are per-share and read-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
