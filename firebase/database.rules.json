{
  "rules": {
    "trips": {
      "$accessKey": {
        ".read": "data.child('meta').child('expiresAt').val() > now",
        "meta": {
          ".write": "!data.exists() || (auth != null && data.child('ownerUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['tripId', 'expiresAt', 'ownerUid'])",
          "expiresAt": { ".validate": "newData.isNumber()" },
          "ownerUid": { ".validate": "auth != null && newData.val() === auth.uid" },
          "$other": { ".validate": true }
        },
        "currentState": {
          ".write": "auth != null && root.child('trips').child($accessKey).child('meta').child('ownerUid').val() === auth.uid",
          "$field": { ".validate": true }
        },
        "events": {
          "$eventId": {
            ".write": "auth != null && newData.exists() && !data.exists() && root.child('trips').child($accessKey).child('meta').child('ownerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'eventTime'])",
            "type": { ".validate": "newData.isString()" },
            "eventTime": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": true }
          }
        },
        "locations": {
          "$sampleId": {
            ".write": "auth != null && newData.exists() && !data.exists() && root.child('trips').child($accessKey).child('meta').child('ownerUid').val() === auth.uid",
            "$other": { ".validate": true }
          }
        }
      }
    }
  }
}
